<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- 使用默认全局包缓存（%USERPROFILE%\.nuget\packages），避免 restore/build 因自定义路径解析失败 (NETSDK1060) -->
  </config>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>